# claude code
CLAUDE.md
.claude/

# deps
node_modules/
.pnp.*

# env & secrets
#
# `*.env` only matches names ENDING in .env, so it did NOT cover `.env.prod` —
# the file holding the production DB password and the session signing secret.
# `.env.*` covers every suffix; the negations re-admit the committed templates.
.env
.env.local
*.env
.env.*
!.env.example
!.env.prod.example

# build output
dist/
build/
web/dist/

# generated fixtures — reproducible via tools/generate-fixtures.js.
# `fixtures/` matches a directory of that NAME at any depth, so it does not
# touch samples/, which holds one period's three files committed on purpose.
fixtures/

# API response dumps. /api/suppliers writes {suppliers, model} and a curl of it
# once landed here as a 90 KB file that read like a checked-in data source.
# fixtures/suppliers.json is the real one and is covered above.
/suppliers.json

# scratch reproductions. Debug scripts belong in a scratch dir, not the repo —
# api/.tmp-repro/ was committed for three phases writing to an unreserved org id.
.tmp-repro/

# ml artifacts
ml/*.csv
ml/__pycache__/
*.pkl

# logs & local db
*.log
logs/
*.sqlite
*.sqlite3

# os / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json