# Copy to .env and adjust. .env is gitignored.

# --- Database ---------------------------------------------------------------
# Host port 3306 is taken by a native MySQL install, so compose maps the
# container's 3306 to 3307 on the host. Use 3307 when running the API on the
# host; inside the compose network the api service overrides DB_HOST=db and
# DB_PORT=3306 (see docker-compose.yml).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=itc
DB_PASSWORD=itc_dev_password
DB_NAME=itc_guard

# Root password for the mysql container only (compose reads this).
DB_ROOT_PASSWORD=root_dev_password

# --- API --------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Recommendations ----------------------------------------------------------
# A value mismatch whose total tax differs by no more than this many paise is
# recommended for Accept as immaterial. Blank means the engine default, 100 (Rs 1):
# the audit brief rejects a Rs 1.35 portal-higher difference, so anything from
# 135 up disagrees with it.
MATERIALITY_TOLERANCE_PAISE=

# --- Web --------------------------------------------------------------------
# Base URL the Vite dev server proxies /api to.
VITE_API_BASE=http://localhost:3000

# --- Per-visitor demo data (public hosting) ---------------------------------
# Off by default: a local run serves one shared org (org 1), which is what
# `npm run demo:reset` seeds and what the screenshots are of.
#
# Turn it on for a publicly reachable deployment. Each visitor is then handed
# their own pre-seeded org via a signed httpOnly cookie, so two people reviewing
# at the same time cannot see each other's confirmations, uploads or re-runs.
DEMO_TENANCY=off

# REQUIRED when DEMO_TENANCY=on. Signs the session cookie. Without it a random
# key is generated at boot, and every restart hands all visitors a new org.
#   openssl rand -hex 32
DEMO_SESSION_SECRET=

# Set to true only when the site is served over HTTPS.
DEMO_COOKIE_SECURE=false

# How many seeded orgs are kept warm, so a first visit is instant rather than
# waiting on a ~5s seed. Beyond the pool, visitors see a "preparing" screen.
DEMO_POOL_SIZE=3

# Hard ceiling on live demo orgs, so several days of judging cannot grow the
# database without limit. Org 1 is not a demo org and never counts towards it.
DEMO_MAX_ORGS=40

# A visitor's org is deleted once untouched for this long.
DEMO_IDLE_MINUTES=180
