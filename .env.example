# Copy to .env and adjust. .env is gitignored.

# --- Database ---------------------------------------------------------------
# Host port 3306 is taken by a native MySQL install, so compose maps the
# container's 3306 to 3307 on the host. Use 3307 when running the API on the
# host; inside the compose network the api service overrides DB_HOST=db and
# DB_PORT=3306 (see docker-compose.yml).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=itc
DB_PASSWORD=itc_dev_password
DB_NAME=itc_guard

# Root password for the mysql container only (compose reads this).
DB_ROOT_PASSWORD=root_dev_password

# --- API --------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Recommendations ----------------------------------------------------------
# A value mismatch whose total tax differs by no more than this many paise is
# recommended for Accept as immaterial. Blank means the engine default, 100 (Rs 1):
# the audit brief rejects a Rs 1.35 portal-higher difference, so anything from
# 135 up disagrees with it.
MATERIALITY_TOLERANCE_PAISE=

# --- Web --------------------------------------------------------------------
# Base URL the Vite dev server proxies /api to.
VITE_API_BASE=http://localhost:3000

# --- Per-visitor workspaces (local dev and public hosting alike) ---------------
# On, as the deployed site runs: each browser is handed its own empty workspace
# via a signed httpOnly cookie, so two people at the same time cannot see each
# other's uploads, decisions or re-runs, and "Clear all data" empties only theirs.
#
# off serves one stubbed trader (org 1), which is what `npm run demo:reset` seeds;
# "Clear all data" then clears that trader's data. The test suites pin it off
# themselves, whatever this says.
DEMO_TENANCY=on

# Signs the session cookie. docker compose fills in a local-only default when this
# is blank; a host `npm run dev` needs any string here, or every restart hands the
# browser a new workspace. A deployment sets its own, in .env.prod:
#   openssl rand -hex 32
DEMO_SESSION_SECRET=

# Set to true only when the site is served over HTTPS.
DEMO_COOKIE_SECURE=false

# How long a visitor's cookie lasts, renewed as they use the app.
DEMO_SESSION_DAYS=180

# Hard ceiling on live demo orgs, so several days of judging cannot grow the
# database without limit. Org 1 is not a demo org and never counts towards it.
DEMO_MAX_ORGS=40

# A workspace untouched for this long is deleted, unless it had an upload within
# DEMO_RETAIN_DAYS: those are kept however idle.
DEMO_IDLE_MINUTES=180
DEMO_RETAIN_DAYS=30

# --- Supplier email (optional) ------------------------------------------------
# Blank SMTP_* = the Email button stays a mailto link and no inbox is polled.
# Gmail: an app password (Google account > Security > App passwords), port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Replies are read from this mailbox (same user and password), every 30 s.
IMAP_HOST=
# The only addresses the app may email, comma-separated, no spaces.
EMAIL_ALLOWLIST=
# Optional: checks each reply's intent. Blank = replies shown unchecked.
GEMINI_API_KEY=
GEMINI_MODEL=
