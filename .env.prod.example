# ITC Guard — production environment.
#
#   cp .env.prod.example .env.prod    then fill in every REQUIRED value
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod is gitignored. Nothing in this file is a real secret; every value
# below is either a placeholder or a safe default.

# =============================================================================
# REQUIRED — the stack refuses to start without these
# =============================================================================

# The public address Caddy answers on, and the ONLY thing that differs between a
# laptop and the server.
#
#   local    :80                plain HTTP, no certificate requested
#   server   itc.example.com    automatic HTTPS from Let's Encrypt
#
# Caddy listens on 80/443 inside the container either way; this only decides
# whether it serves TLS there. Use HTTP_PORT/HTTPS_PORT below to move the HOST
# side if 80 is taken.
#
# It must be a DNS NAME, not an IP — a public CA will not issue a certificate for
# a bare address. If you do not have a domain, `<public-ip>.sslip.io` resolves to
# that IP and does get a certificate (e.g. 13-51-2-7.sslip.io for 13.51.2.7).
# Let's Encrypt refuses *.compute.amazonaws.com, so the EC2 hostname will not work.
SITE_ADDRESS=itc.example.com

# Optional. Caddy registers its ACME account without a contact address by
# default (see the note in deploy/Caddyfile explaining why it is not wired to a
# placeholder), so leaving this blank is fine and is what a local run uses.
ACME_EMAIL=

# Host ports Caddy is published on. Defaults are the real ones; a local smoke
# test typically uses HTTP_PORT=8080 with SITE_ADDRESS=:80.
HTTP_PORT=80
HTTPS_PORT=443

# Database credentials. Generate, do not invent:
#   openssl rand -base64 24
DB_ROOT_PASSWORD=CHANGE_ME_root
DB_PASSWORD=CHANGE_ME_app

# Signs the session cookie that gives each visitor their own demo org. Without a
# stable value the API generates a random key at boot, and every restart or
# redeploy hands all open sessions a brand new empty org mid-review.
#   openssl rand -hex 32
DEMO_SESSION_SECRET=CHANGE_ME_64_hex_characters

# =============================================================================
# Database
# =============================================================================
DB_NAME=itc_guard
DB_USER=itc
# DB_HOST and DB_PORT are set by compose to the internal db service. Do not put
# them here — the container values must win.

# =============================================================================
# Per-visitor demo data
# =============================================================================
# Each visitor gets a private workspace, empty to start with and addressed by a
# signed httpOnly cookie, so two judges reviewing at once never see each other's
# uploads or decisions.
#
# ALL of these are read on access rather than cached at import, so tuning one is
# a value change here plus:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d api
DEMO_TENANCY=on

# Must be true when SITE_ADDRESS is an https hostname, false for a plain-HTTP
# local run — a Secure cookie is silently dropped over HTTP and every request
# then looks like a first visit.
DEMO_COOKIE_SECURE=true

# How long a visitor's cookie lasts, renewed as they use the app, so a workspace
# survives coming back days later.
DEMO_SESSION_DAYS=180

# Hard ceiling on live workspaces, so several days of judging cannot grow the
# database without limit. At the cap an idle, unused workspace is reclaimed; if
# there is none, a new visitor is refused with a stated reason rather than the
# box filling up.
#
# 200 is sized for a t3.micro. A new workspace is one organizations row with no
# seeding, and the API holds no per-workspace memory, so the cap bounds DISK: a
# workspace that plays the whole demo (Aug + Sep, every upload) is well under
# 1 MB, so 200 of them are ~200 MB of an 8 GB volume. RAM is set by the buffer
# pool (96M) and the 10-connection pool, neither of which grows with workspaces.
# It is high because every cookieless /api request (a link preview, a scanner)
# mints one; at the cap, one that never had an upload is reclaimed after 10 idle
# minutes. Lower it only if the disk, not the memory, is short.
DEMO_MAX_ORGS=200

# A workspace untouched for this long is deleted, unless it had an upload within
# DEMO_RETAIN_DAYS: those are kept however idle.
DEMO_IDLE_MINUTES=180
DEMO_RETAIN_DAYS=30

# How often the reaper deletes idle workspaces. Applied when the api container
# restarts.
DEMO_SWEEP_MINUTES=5

# A value mismatch whose total tax differs by no more than this many paise is
# recommended for Accept as immaterial. Blank means the engine default, 100 (Rs 1).
# Read at each reconciliation run; existing runs keep their verdicts until re-run.
MATERIALITY_TOLERANCE_PAISE=

# =============================================================================
# Memory limits — 1 GB box
# =============================================================================
# These are hard cgroup caps. They total 752 MB, leaving ~200 MB for Ubuntu and
# the Docker daemon. A service that runs away is killed and restarted by
# `restart: unless-stopped` rather than taking the instance down with it.
#
# If the box is under pressure, in this order:
#   1. DEMO_MAX_ORGS down (less data, so less buffer pool pressure)
#   2. DB_MEM_LIMIT down to 320M and innodb_buffer_pool_size to 64M
#      in deploy/mysql/small.cnf
DB_MEM_LIMIT=384M
API_MEM_LIMIT=256M
WEB_MEM_LIMIT=48M
CADDY_MEM_LIMIT=64M

# Keeps V8's heap inside API_MEM_LIMIT so a heavy seed gets a garbage collection
# instead of an OOM kill. Keep this comfortably below API_MEM_LIMIT.
API_NODE_OPTIONS=--max-old-space-size=192

# --- Supplier email (optional) ------------------------------------------------
# Blank SMTP_* = the Email button stays a mailto link and no inbox is polled.
# Gmail: an app password (Google account > Security > App passwords), port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Replies are read from this mailbox (same user and password), every 30 s.
IMAP_HOST=
# The only addresses the app may email, comma-separated, no spaces.
EMAIL_ALLOWLIST=
# Optional: checks each reply's intent. Blank = replies shown unchecked.
GEMINI_API_KEY=
GEMINI_MODEL=
# Who npm run mail:selftest writes to when no address is given (allowlisted).
MAIL_SELFTEST_TO=

# --- Supplier WhatsApp (optional) ---------------------------------------------
# Meta WhatsApp Cloud API. Blank WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID or
# WHATSAPP_TEMPLATE_NAME = the WhatsApp button stays a wa.me link.
# From the Meta app: WhatsApp > API Setup (token, phone number id, business
# account id) and App settings > Basic (app secret).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Signs the webhook POSTs; a POST without a valid X-Hub-Signature-256 is refused.
WHATSAPP_APP_SECRET=
# Any string you choose; the same one goes into the Meta app's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# The approved template that opens a thread, with five body variables:
# {{1}} supplier contact, {{2}} trader, {{3}} invoice no., {{4}} invoice date, {{5}} the ask.
WHATSAPP_TEMPLATE_NAME=
# Optional: the template's language code exactly as in WhatsApp Manager, e.g. en_US
# (default en).
WHATSAPP_TEMPLATE_LANG=
# How a thread's first message goes: "template" (default; free text only within 24 h
# of the supplier's last message) or "text" (always the full message as free text,
# which WhatsApp delivers only inside that 24 h window; for before the template is
# approved).
WHATSAPP_FIRST_MESSAGE=
# The only numbers the app may message: digits with country code, comma-separated.
WHATSAPP_ALLOWLIST=
# Optional: Graph API version (default v26.0).
WHATSAPP_GRAPH_VERSION=
